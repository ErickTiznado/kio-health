# ============================================================
# Kio Health API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Database (Supabase) ──────────────────────────────────────
# Connection string with PgBouncer (for Prisma query engine)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL="https://[project-ref].supabase.co"

# Service role key — has full DB access, keep secret
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Authentication ────────────────────────────────────────────
# Min 64 random bytes as hex. Generate:
#   node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET="<64-random-bytes-as-hex>"

# ── Encryption ────────────────────────────────────────────────
# Exactly 32 random bytes as hex (64 hex chars). Generate:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
# WARNING: Rotating this key requires re-encrypting all existing data.
ENCRYPTION_KEY="<32-random-bytes-as-hex>"

# ── Seed (development only) ───────────────────────────────────
# Password used when running `npx prisma db seed`. Never use in production.
SEED_PASSWORD="<strong-password>"

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production
# ALLOWED_ORIGINS="https://kioind.com,https://www.kioind.com"

# ── URLs de los servicios ─────────────────────────────────────
# URL pública del frontend. Se usa en emails (Resend), links de invitación,
# redirects del OAuth de Google y reset de contraseña.
FRONTEND_URL="http://localhost:5173"
# URL pública de esta API. La usan los recordatorios para construir el link
# de confirmación que recibe el paciente por email.
API_URL="http://localhost:3001"

# ── Email (Resend) ────────────────────────────────────────────
# API key de Resend para emails transaccionales (recordatorios, reset, invites)
RESEND_API_KEY="re_..."

# ── Google Calendar (OAuth) ───────────────────────────────────
# Credenciales de la app OAuth para la integración de Google Calendar.
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
# Debe coincidir con la URI registrada en Google Cloud Console.
GOOGLE_REDIRECT_URI="http://localhost:3001/api/integrations/google/callback"

# ── Monitoreo (Sentry) ────────────────────────────────────────
# DSN de Sentry para reporte de errores del backend. Opcional en local.
SENTRY_DSN=""

# Qué hace la app cuando la prueba de 15 días caduca.
#   READ_ONLY (por defecto) — se consulta todo, no se escribe nada. Modo beta.
#   HARD                    — la app queda bloqueada hasta elegir plan. Modo live.
TRIAL_EXPIRED_MODE=READ_ONLY
