# ============================================================
# Kio Health Web — Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# URL of the NestJS API
VITE_API_URL=http://localhost:3001

# Sentry DSN for frontend error reporting. Optional in local dev.
VITE_SENTRY_DSN=

# Analítica de producto (PostHog). Sin la clave, la analítica es un no-op
# completo: no se manda nada y los eventos salen por consola en dev.
# Region EU por defecto — el proyecto maneja datos clínicos bajo RGPD.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
